{
  "name": "halo-overlay",
  "productName": "Halo",
  "version": "6.2.0",
  "description": "Music-reactive screen-edge glow, synced lyrics and a spinning record overlay for Windows",
  "author": "Halo",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:store": "electron-builder --win appx --x64 --publish never",
    "fix-electron": "powershell -NoProfile -ExecutionPolicy Bypass -File fix-electron.ps1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.halo.overlay",
    "productName": "Halo",
    "copyright": "Halo",
    "artifactName": "Halo-Setup-${version}.exe",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "media-filter.js",
      "preload.js",
      "settings-preload.js",
      "overlay.html",
      "renderer.js",
      "scenes.js",
      "settings.html",
      "settings.js",
      "build/icon.png",
      "build/logo.png",
      "fonts/GoogleSans.ttf",
      "fonts/OFL-GoogleSans.txt",
      "LICENSE",
      "PRIVACY.md"
    ],
    "extraResources": [
      "media.ps1",
      "zorder.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Halo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "appx": {
      "applicationId": "Halo",
      "displayName": "HaloVisual",
      "identityName": "arvgdhi.HaloVisual",
      "publisher": "CN=C9757632-C4CD-433A-B235-92B52815EBD1",
      "publisherDisplayName": "arvgdhi",
      "artifactName": "HaloVisual-${version}.${ext}",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arvgdhi/HaloVisual.git"
  }
}